{
  "_version": "1.49.0",
  "sap.app": {
    "id": "zbsi.batchsupplierinvoice",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.14.7",
      "toolsId": "349d97a6-2581-42cb-b1ec-963e6f9cd1de"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsb_bsi_upload/srvd_a2x/sap/zsd_bsi_upload/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "batchsupplierinvoice-display": {
          "semanticObject": "batchsupplierinvoice",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zbsi.batchsupplierinvoice.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "js": [
        {
          "uri": "lib/xlsx.full.min.js"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_BSI_UploadList",
          "target": "ZC_BSI_UploadList"
        },
        {
          "pattern": "ZC_BSI_Upload({key}):?query:",
          "name": "ZC_BSI_UploadObjectPage",
          "target": "ZC_BSI_UploadObjectPage"
        }
      ],
      "targets": {
        "ZC_BSI_UploadList": {
          "type": "Component",
          "id": "ZC_BSI_UploadList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_BSI_Upload",
              "variantManagement": "Page",
              "navigation": {
                "ZC_BSI_Upload": {
                  "detail": {
                    "route": "ZC_BSI_UploadObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "UploadExcel": {
                      "id": "UploadExcelButton",
                      "text": "Importar Planilha",
                      "press": "zbsi.batchsupplierinvoice.ext.controller.UploadExcel.openUploadDialog",
                      "requiresSelection": false,
                      "position": {
                        "placement": "Before",
                         "anchor": "DataFieldForAction::ExecuteBatch"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ZC_BSI_UploadObjectPage": {
          "type": "Component",
          "id": "ZC_BSI_UploadObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_BSI_Upload"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
